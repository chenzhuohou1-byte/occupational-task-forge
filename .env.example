# 仓库根的 .env 样例。复制成 .env 后填自己的值；.env 不入版本库。
# config.py 在 import 时自动读它；已存在的环境变量优先，命令行临时覆盖照旧有效。

# —— 数据目录（框架开源、数据私有，必须指到仓库外）——
ALE_TASKS_DIR=/path/to/private/tasks
ALE_RUNS_DIR=/path/to/private/runs
# 网关价目表（含结算倍率，属内部商务信息）。缺这个文件时产线照常跑，所有模型记为「未计价」
ALE_PRICING_FILE=/path/to/private/pricing.local.json

# —— LLM 网关（N1/N2a/N3~5 起草与 N7 盲解用）——
ALE_LLM_PROVIDER=openai
ALE_LLM_API_BASE=https://<你的 OpenAI 兼容网关>/v1
ALE_LLM_MODEL=<模型名>
ALE_LLM_API_KEY=<你的 key>
# 可选：网关偶发超时/504 时调这两个
ALE_LLM_TIMEOUT=900
ALE_LLM_RETRIES=3
